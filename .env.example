# Copy to .env for local use (`npm run fetch-census`, `vercel dev`).
# .env is git-ignored. In production, set these in Vercel:
#   vercel env add CENSUS_API_KEY
#   vercel env add ALLOWED_ORIGINS

# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Sites allowed to call the API from a browser (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://YOUR-GITHUB-USERNAME.github.io,http://localhost:8000

# Newest ACS 5-year vintage the API will serve (2024 = 2020-2024 estimates).
# Bump when the Census Bureau publishes a new release (usually December).
ACS_LATEST_YEAR=2024
